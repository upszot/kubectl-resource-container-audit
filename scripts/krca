#!/usr/bin/env python3
# scripts/krca - Punto de entrada para desarrollo (delega en el paquete)
#
# Se conserva por compatibilidad con instalaciones que ejecutan este script
# directamente desde el checkout. La implementación real vive en
# krca/__main__.py, que también es el entry point de pip/Homebrew.

import sys
from pathlib import Path

# Asegurar que el paquete krca es importable desde el checkout.
try:
    from krca.__main__ import main
except ImportError:
    parent_dir = str(Path(__file__).parent.parent.resolve())
    if parent_dir not in sys.path:
        sys.path.insert(0, parent_dir)
    from krca.__main__ import main


if __name__ == "__main__":
    sys.exit(main())
