#!/usr/bin/env python3
# scripts/krca - Punto de entrada para desarrollo (delega en el paquete)
#
# Se conserva por compatibilidad con instalaciones que ejecutan este script
# directamente desde el checkout. La implementación real vive en
# krca/__main__.py, que también es el entry point de pip/Homebrew.

import sys
from pathlib import Path

# Prioridad absoluta al paquete que está junto a este script, tanto en un
# checkout como en una instalación (evita mezclar con una copia en
# site-packages).
PACKAGE_ROOT = str(Path(__file__).resolve().parent.parent)
if PACKAGE_ROOT not in sys.path:
    sys.path.insert(0, PACKAGE_ROOT)

from krca.__main__ import main


if __name__ == "__main__":
    sys.exit(main())
